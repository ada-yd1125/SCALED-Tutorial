#!/bin/bash
#PBS -N scaled_l1_flow
#PBS -l select=1:ncpus=4:mem=48gb:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

module purge
module load tools/prod
module load PyTorch/2.1.2-foss-2023a-CUDA-12.1.1
source .venv/bin/activate

python scripts/run_l1_flow_inference.py \
    --steps "${STEPS:-1}" \
    --device cuda \
    --precision fp16 \
    --output-dir outputs/l1_flow_inference

echo "Generated files:"
find outputs/l1_flow_inference -maxdepth 1 -type f -print
